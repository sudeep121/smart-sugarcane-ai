# Keep the serving image small. It is built for a 512 MB free tier, so
# anything the running app does not read is excluded.

.git
.gitattributes
node_modules
**/node_modules
**/__pycache__
**/*.pyc
backend/venv
frontend/dist
frontend/android
datasets
uploads
docs
deploy

# Keras originals are ~41 MB and the server never loads them: it serves the
# ONNX exports. They stay in the repository for retraining and re-export.
models/*.keras
models/*.h5

# Local databases, environment files and build artefacts.
*.db
*.sqlite3
**/.env
*.pptx
*.pdf
*.apk
