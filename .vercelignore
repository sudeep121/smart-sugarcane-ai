# Keep the serverless function under Vercel's 250 MB limit.
#
# IMPORTANT: these patterns follow .gitignore semantics, so a bare "models/"
# matches a directory of that name at ANY depth. That silently removed
# backend/app/models/ and backend/app/ml/ from the deployment and the function
# died with ModuleNotFoundError: No module named 'app.models'.
#
# Anything meant as a project-root directory MUST start with a slash.

# Training scripts (project root only - NOT backend/app/ml or
# backend/app/models, which are application code).
/ml/

# The ONNX models ARE deployed: 26 MB, and they are what makes the live site
# run the real classifiers instead of demo heuristics. Everything else under
# models/ is excluded because the function cannot use it:
#   *.keras / *.h5  - 41 MB, and loading them needs TensorFlow, which does not
#                     fit in 250 MB. The .onnx exports replace them.
#   *.joblib        - the irrigation model needs scikit-learn and SciPy, a
#                     further 154 MB. Irrigation therefore runs on the FAO-56
#                     rule engine here, which the interface states plainly.
/models/*.keras
/models/*.h5
/models/*.joblib

/docs/
/.vscode/

backend/venv/
backend/smoke_test.py
backend/calibration_check.py

# Local state
**/__pycache__/
**/*.pyc
**/.env
*.db
*.sqlite3
backend/smart_sugarcane.db
/uploads/

# Tooling that has no business in a serverless bundle
*.bat
Dockerfile
.dockerignore
render.yaml
