# Copy to .env and fill in. `docker compose` reads .env automatically.

# The hostname Caddy will request a certificate for. A free DuckDNS subdomain
# works: create one at duckdns.org and point it at this VM's public IP.
DOMAIN=yourname.duckdns.org

# Signs the login tokens. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=replace-me-with-32-random-bytes

# Optional. Leave unset to keep SQLite on the mounted volume, which survives
# container restarts but not the VM being destroyed.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Optional live weather. Without it the app says so rather than inventing data.
# OPENWEATHER_API_KEY=
DEFAULT_WEATHER_CITY=Belagavi,IN
